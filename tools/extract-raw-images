#!/usr/bin/env python3
"""Extract training PNG images from an RMCS record.raw + record.csv pair."""

import argparse
import csv
from pathlib import Path
import sys

import cv2
import numpy as np


def positive_int(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("record", type=Path, help="recording directory, record.raw or record.csv")
    parser.add_argument("--interval", type=positive_int, default=10,
                        help="take one image every N frames, starting at frame 0 (default: 10)")
    parser.add_argument("--output", type=Path,
                        help="override output directory (default: data/raw_image/<recording directory>)")
    parser.add_argument("--limit", type=positive_int, help="maximum number of images to export")
    args = parser.parse_args()

    folder = args.record.resolve()
    if folder.is_file():
        folder = folder.parent
    output = args.output or Path(__file__).resolve().parents[1] / "data/raw_image" / folder.name
    required = {"raw_offset_bytes", "raw_size_bytes", "width", "height", "opencv_cvt_color_code"}
    count = 0
    with (folder / "record.raw").open("rb") as raw, \
            (folder / "record.csv").open(newline="") as metadata:
        rows = csv.DictReader(metadata)
        if not required.issubset(rows.fieldnames or []):
            raise ValueError("CSV is missing required image metadata columns")
        raw.seek(0, 2)
        raw_size = raw.tell()
        output.mkdir(parents=True, exist_ok=True)
        for index, row in enumerate(rows):
            if index % args.interval:
                continue
            offset, size, width, height, code = (
                int(row[key]) for key in (
                    "raw_offset_bytes", "raw_size_bytes", "width", "height", "opencv_cvt_color_code"
                )
            )
            if width <= 0 or height <= 0 or size != width * height or offset < 0:
                raise ValueError(f"frame {index}: invalid Bayer image metadata")
            if offset + size > raw_size:
                raise ValueError(f"frame {index}: incomplete RAW data; stop recording before exporting")
            raw.seek(offset)
            data = raw.read(size)
            if len(data) != size:
                raise ValueError(f"frame {index}: incomplete RAW data")
            bayer = np.frombuffer(data, dtype=np.uint8).reshape(height, width)
            image = cv2.demosaicing(bayer, code)
            # Exclusive creation prevents overwriting earlier exports or annotations.
            # prepare splits train/val by the <recording>_f<frame> name.
            path = output / f"{folder.name}_f{index:07d}.png"
            ok, encoded = cv2.imencode(".png", image)
            if not ok:
                raise RuntimeError(f"frame {index}: PNG encoding failed")
            with path.open("xb") as destination:
                destination.write(encoded.tobytes())
            count += 1
            if args.limit and count >= args.limit:
                break
    print(f"Exported {count} PNG images to {output.resolve()}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, cv2.error) as error:
        print(f"Export failed: {error}", file=sys.stderr)
        sys.exit(1)
