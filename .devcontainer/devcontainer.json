// For format details, see https://containers.dev/implementors/json_reference/
{
  "name": "YOLO GPU Training",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.local.yml"
  ],
  "service": "yolo-train",
  "workspaceFolder": "/workspace",
  // Dev Containers remaps ubuntu's UID/GID to the host user, so files in /workspace stay owned by you.
  "remoteUser": "ubuntu",
  "initializeCommand": "bash .devcontainer/scripts/ensure-image.sh && bash .devcontainer/scripts/ensure-local-override.sh",
  "postCreateCommand": "bash .devcontainer/scripts/setup-shell-history.sh && bash .script/check-env",
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "/usr/bin/python3"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "redhat.vscode-yaml",
        "mhutchie.git-graph"
      ]
    }
  }
}
